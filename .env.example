# MGA environment template. Copy to .env (gitignored) and fill in.
# Used by docker-compose.yml; on a hosting platform set the same names in its dashboard.
# Placeholders only: never commit real values.
#
# Lines starting with "#" are optional and fall back to the default shown.
# Do not set optional variables to an empty value; leave them commented out.

# ---------------------------------------------------------------- core (API)
# development | production. Production refuses to start without MGA_DATA_KEY,
# DATABASE_URL (Postgres) and an email provider, and turns on Secure cookies.
# docker-compose defaults to development so it works with no email provider
# (the login code is returned in the response). See docker-compose.yml to flip it.
MGA_ENV=development

# Postgres connection string. Required in production, must be Postgres there.
# docker-compose builds this itself from POSTGRES_PASSWORD; set it only on a host.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# (postgres:// and postgresql:// URLs from Render/Heroku-style providers are rewritten automatically.)
# Default outside compose: sqlite:///./mga-dev.db

# Password for the compose-managed Postgres (compose only). Change it if the db port is ever exposed.
POSTGRES_PASSWORD=mga

# Fernet key(s) that encrypt resumes, interview answers and saved reports. REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Several keys separated by commas, newest first, to rotate (see docs/DEPLOY.md).
# Lose the key and stored data cannot be decrypted. Back it up separately from the database.
MGA_DATA_KEY=

# Admin token for POST /jobs/import (sent as the X-Admin-Token header). Unset = endpoint disabled.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MGA_ADMIN_TOKEN=

# ------------------------------------------------------------------- email
# One is required in production. Without either, dev mode returns the login code instead.
# Resend (HTTP API). The sending domain must be verified in Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Or SMTP: smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465 (TLS)
# MGA_SMTP_URL=
# From address for login emails. Must belong to your verified domain.
# MGA_EMAIL_FROM=MGA <login@example.com>

# ------------------------------------------------------------- sign-in options
# Google sign-in: OAuth Web client ID (no secret needed). Unset = Google button hidden.
# GOOGLE_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# ---------------------------------------------------------- sessions & cookies
# Session lifetime in days (default 30).
# MGA_SESSION_DAYS=30
# Cookie domain; leave unset for a host-only cookie (recommended).
# MGA_COOKIE_DOMAIN=
# Secure flag on the session cookie. Default: on in production, off otherwise.
# Set to 0 only to test a production-mode stack over plain http://localhost.
# MGA_COOKIE_SECURE=1

# ------------------------------------------------------------ networking
# Set to 1 behind a load balancer / platform proxy so rate limits see the client IP
# from X-Forwarded-For. Leave off if the API is directly reachable by clients.
# MGA_TRUST_PROXY=1
# Browser origins allowed to call the API with cookies, comma-separated (default http://localhost:3000).
# Set to the site origin, e.g. https://mga.example.com
MGA_CORS_ORIGINS=http://localhost:3000
# Where the Next.js server proxies /api/* (read at frontend build and start time).
# compose sets this to http://api:8000. On Vercel set it to the API's public URL.
MGA_API_URL=http://localhost:8000
# gunicorn worker processes per API container (default 2).
# WEB_CONCURRENCY=2

# ----------------------------------------------------------------- database behaviour
# Create tables on first use. Default: on outside production, off in production (use Alembic).
# MGA_AUTO_CREATE=0
# Load the synthetic sample postings once (default on).
# MGA_SEED_SAMPLES=1

# -------------------------------------------------------------- job sources
# Adzuna job search (optional). "Jobs by Adzuna" must be shown next to Adzuna results.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# ------------------------------------------------------------ AI (optional)
# The rules engine works without any of these. Set a key to add Claude extraction and wording.
# ANTHROPIC_API_KEY=
# MGA_MODEL=claude-opus-5-5
# MGA_LLM_EFFORT=low
# Force AI off even when a key is set: MGA_LLM=0
# MGA_LLM=0

# ---- Added with the security hardening ----
# MGA_ENV must be exactly "development", "test" or "production". Anything else (or unset) is treated
# as production and the API refuses to start without its secrets. Use MGA_ENV=development locally.
# Separate secret for hashing sign-in codes (optional; derived from MGA_DATA_KEY when unset).
# MGA_HMAC_KEY=
# Local development only: return sign-in codes in the API response. Ignored in production.
# MGA_DEV_ECHO_CODES=1
# Number of proxies in front of the API that append to X-Forwarded-For (used with MGA_TRUST_PROXY=1).
# MGA_PROXY_HOPS=1
# Let signed-out visitors use Claude (costs money). Default off: anonymous requests run rules-only.
# MGA_LLM_PUBLIC=0
# Days to keep audit-log rows of deleted accounts (python -m app.maintenance).
# MGA_AUDIT_DAYS=365
